{
  "projectType": "web",
  "framework": "vanilla-js",
  "language": "javascript",
  "features": [
    "client-side-parsing",
    "http-archive-viewer",
    "performance-analysis"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "match": {
          "tool": "Write"
        },
        "action": {
          "command": "echo 'New file created: $FILE_PATH'"
        }
      },
      {
        "match": {
          "tool": "Edit"
        },
        "action": {
          "command": "echo 'File modified: $FILE_PATH'"
        }
      }
    ],
    "PostToolBatch": [
      {
        "match": {
          "command": "npm run build"
        },
        "action": {
          "command": "echo 'Build completed'"
        }
      }
    ]
  },
  "permissions": {
    "read": [
      "src/**/*",
      "index.html",
      "docs/**/*",
      "tests/**/*"
    ],
    "write": [
      "src/**/*",
      "index.html",
      "docs/**/*",
      "tests/**/*"
    ]
  }
}