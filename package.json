{
  "name": "har-viewer",
  "version": "1.0.0",
  "description": "A client-side HAR (HTTP Archive) viewer inspired by Fiddler",
  "main": "src/index.ts",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview",
