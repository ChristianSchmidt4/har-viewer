    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "babel-jest": "^29.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "lit": "^3.0.0"
  }
